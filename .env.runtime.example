# ReelForge runtime environment, shared by the API, every worker and the smoke tests.
#
# Copy this file to .env.runtime (git-ignored) and fill in only what you use.
# The API (at startup), python -m app.text_worker, app.image_worker, app.video_worker, app.voice_worker,
# app.render_worker, app.source_worker, app.youtube_worker, app.social_worker, app.scheduler_worker,
# app.provider_check and app.smoke_test all load .env.runtime; REELFORGE_ENV_FILE names another file.
# In production, point every systemd unit at the same file with EnvironmentFile=.
# Format: KEY=value, one per line. A variable already set in the process wins over this file.
# Never commit the filled-in file, and never paste keys into issues, logs or screenshots.

# Text providers (AI tool task "Text"). OPENAI_API_KEY also serves transcription (task "Transcription", whisper-1).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Also used by Voice (AI tool task "Voice", Gemini text-to-speech).
GEMINI_API_KEY=

# Video providers
FAL_KEY=
RUNWARE_API_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
# Comma-separated hostnames Runway result files may be downloaded from (required with Runway,
# for both video and images).
RUNWAY_OUTPUT_HOSTS=

# Image generation (AI tool task "Image") uses Runway: RUNWAYML_API_SECRET and RUNWAY_OUTPUT_HOSTS above.

# Experimental Dola gateway; leave empty unless you operate one.
DOLA_EXPERIMENTAL_ENABLED=
DOLA_BASE_URL=
DOLA_API_KEY=

# Prices in credits (defaults: 10 per clip, 1 per text generation, 2 per image, 1 per narration,
# 0 per render). A step that makes one clip, image or narration per scene holds this price once per scene.
VIDEO_CREDITS_PER_CLIP=
TEXT_CREDITS_PER_GENERATION=
IMAGE_CREDITS_PER_GENERATION=
VOICE_CREDITS_PER_GENERATION=
RENDER_CREDITS_PER_JOB=
# Transcript steps (python -m app.source_worker): credits per transcription (default 2) and the longest
# media accepted, in seconds (60 to 43200, default 10800). Audio is sent in pieces of at most 20 minutes.
TRANSCRIPTION_CREDITS_PER_JOB=
TRANSCRIPTION_MAX_SECONDS=

# How long a job may wait for its provider before its credits are held for review
# (seconds, 60 to 86400; defaults: 21600 for video, 3600 for images, 1800 for voice).
VIDEO_JOB_MAX_AGE_SECONDS=
IMAGE_JOB_MAX_AGE_SECONDS=
VOICE_JOB_MAX_AGE_SECONDS=

# Rendering with system FFmpeg (python -m app.render_worker). Leave the paths empty to use ffmpeg/ffprobe
# from PATH. RENDER_SUBTITLE_FONT is the font family for burned-in subtitles (default "Noto Sans"; install
# fonts-noto-core and fonts-noto-cjk for Vietnamese and Japanese). RENDER_TIMEOUT_SECONDS: 60 to 21600, default 1800.
RENDER_FFMPEG_PATH=
RENDER_FFPROBE_PATH=
RENDER_SUBTITLE_FONT=
RENDER_TIMEOUT_SECONDS=
# Seconds each still image shows when it has no narration of its own (1 to 60, default 5).
RENDER_STILL_SECONDS=

# Media storage (docs/STORAGE.md). One root for every media file, shared by the API and all workers;
# it wins over the storage_dir setting. On the home server: /srv/data/videos/reelforge (an HDD mount, not a link).
REELFORGE_STORAGE_ROOT=
# Optional cap on every studio's storage, in bytes. Plans set their own limits in Admin → Plans
# (Trial 1 GB, Standard 10 GB, Pro 30 GB by default); this also applies to plans without a limit (1 GiB if unset).
WORKSPACE_MEDIA_QUOTA_BYTES=
# Retention in days for python -m app.media_maintenance (run daily at 03:00 with --apply --intermediates).
# Intermediate media (scene clips, narration, generated images, extracted clips) of runs with a final video
# expires after REELFORGE_RETENTION_INTERMEDIATE_DAYS (default 30; 0 keeps it). Final videos and uploads never expire.
REELFORGE_RETENTION_INTERMEDIATE_DAYS=
REELFORGE_RETENTION_TEMP_DAYS=
REELFORGE_RETENTION_PARTIAL_DAYS=
REELFORGE_RETENTION_ORPHAN_DAYS=

# YouTube publishing
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Fernet key that encrypts every stored OAuth token and upload session (YouTube, TikTok, Facebook), and the
# payment gateway credentials saved in Admin -> Payments -> Payment gateways (Phase 19). Without it, gateways
# cannot be configured from the admin UI. Generate once, back it up with the database, never change it: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REELFORGE_TOKEN_ENCRYPTION_KEY=

# TikTok publishing (python -m app.social_worker), Content Posting API with the video.upload scope.
# The redirect URI is the frontend's /channels/callback/tiktok page, registered in the TikTok developer portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Scopes your TikTok app is approved for (default user.info.basic,video.upload).
TIKTOK_APPROVED_SCOPES=

# Facebook Page Reels (python -m app.social_worker), Facebook Login with pages_show_list,
# pages_read_engagement and pages_manage_posts. Redirect URI: the frontend's /channels/callback/facebook page.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# OnePAY card payments, legacy configuration (docs/PAYMENTS.md). Since Phase 19 a system admin configures cards in
# Admin -> Payments -> Payment gateways instead; a saved admin configuration takes precedence over these. The hash key is hex.
# Register with OnePAY: IPN https://<frontend>/api/webhooks/onepay, return https://<frontend>/api/billing/onepay/return.
# The URLs default to OnePAY production; use the sandbox URLs from OnePAY while testing.
ONEPAY_MERCHANT_ID=
ONEPAY_ACCESS_CODE=
ONEPAY_HASH_KEY=
ONEPAY_PAYMENT_URL=
ONEPAY_QUERY_URL=
# QueryDR credentials: confirm a browser return and power "Check" for card orders.
ONEPAY_QUERY_USER=
ONEPAY_QUERY_PASSWORD=

# Notifications (docs/NOTIFICATIONS.md). Seconds between checks for new notifications per open stream
# (default 3), and seconds before the API ends a stream so the browser reconnects (default 300).
REELFORGE_SSE_POLL_SECONDS=
REELFORGE_SSE_MAX_SECONDS=
# Owners are notified once when a debit takes the balance below this many credits (default 20; 0 turns it off).
CREDITS_LOW_THRESHOLD=

# Logging: json (default) or text; level INFO by default.
REELFORGE_LOG_FORMAT=
REELFORGE_LOG_LEVEL=

# Live smoke test choices (python -m app.provider_check / app.smoke_test).
# Live tests also need REELFORGE_LIVE_TESTS=1 or --live in the shell; setting it here has no effect.
REELFORGE_SMOKE_TEXT_PROVIDER=
REELFORGE_SMOKE_TEXT_MODEL=
REELFORGE_SMOKE_VIDEO_PROVIDER=
REELFORGE_SMOKE_VIDEO_MODEL=
REELFORGE_SMOKE_IMAGE_PROVIDER=
REELFORGE_SMOKE_IMAGE_MODEL=
REELFORGE_SMOKE_VOICE_PROVIDER=
REELFORGE_SMOKE_VOICE_MODEL=
