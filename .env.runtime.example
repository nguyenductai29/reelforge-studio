# ReelForge runtime environment, shared by the API, every worker and the smoke tests.
#
# Copy this file to .env.runtime (git-ignored) and fill in only what you use.
# The API (at startup), python -m app.text_worker, app.image_worker, app.video_worker, app.voice_worker,
# app.render_worker, app.youtube_worker,
# app.provider_check and app.smoke_test all load .env.runtime; REELFORGE_ENV_FILE names another file.
# In production, point every systemd unit at the same file with EnvironmentFile=.
# Format: KEY=value, one per line. A variable already set in the process wins over this file.
# Never commit the filled-in file, and never paste keys into issues, logs or screenshots.

# Text providers (AI tool task "Text")
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Also used by Voice (AI tool task "Voice", Gemini text-to-speech).
GEMINI_API_KEY=

# Video providers
FAL_KEY=
RUNWARE_API_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
# Comma-separated hostnames Runway result files may be downloaded from (required with Runway,
# for both video and images).
RUNWAY_OUTPUT_HOSTS=

# Image generation (AI tool task "Image") uses Runway: RUNWAYML_API_SECRET and RUNWAY_OUTPUT_HOSTS above.

# Experimental Dola gateway; leave empty unless you operate one.
DOLA_EXPERIMENTAL_ENABLED=
DOLA_BASE_URL=
DOLA_API_KEY=

# Prices in credits (defaults: 10 per clip, 1 per text generation, 2 per image, 1 per narration,
# 0 per render). A step that makes one clip, image or narration per scene holds this price once per scene.
VIDEO_CREDITS_PER_CLIP=
TEXT_CREDITS_PER_GENERATION=
IMAGE_CREDITS_PER_GENERATION=
VOICE_CREDITS_PER_GENERATION=
RENDER_CREDITS_PER_JOB=

# How long a job may wait for its provider before its credits are held for review
# (seconds, 60 to 86400; defaults: 21600 for video, 3600 for images, 1800 for voice).
VIDEO_JOB_MAX_AGE_SECONDS=
IMAGE_JOB_MAX_AGE_SECONDS=
VOICE_JOB_MAX_AGE_SECONDS=

# Rendering with system FFmpeg (python -m app.render_worker). Leave the paths empty to use ffmpeg/ffprobe
# from PATH. RENDER_SUBTITLE_FONT is the font family for burned-in subtitles (default "Noto Sans"; install
# fonts-noto-core and fonts-noto-cjk for Vietnamese and Japanese). RENDER_TIMEOUT_SECONDS: 60 to 21600, default 1800.
RENDER_FFMPEG_PATH=
RENDER_FFPROBE_PATH=
RENDER_SUBTITLE_FONT=
RENDER_TIMEOUT_SECONDS=

# YouTube publishing
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
REELFORGE_TOKEN_ENCRYPTION_KEY=

# Logging: json (default) or text; level INFO by default.
REELFORGE_LOG_FORMAT=
REELFORGE_LOG_LEVEL=

# Live smoke test choices (python -m app.provider_check / app.smoke_test).
# Live tests also need REELFORGE_LIVE_TESTS=1 or --live in the shell; setting it here has no effect.
REELFORGE_SMOKE_TEXT_PROVIDER=
REELFORGE_SMOKE_TEXT_MODEL=
REELFORGE_SMOKE_VIDEO_PROVIDER=
REELFORGE_SMOKE_VIDEO_MODEL=
REELFORGE_SMOKE_IMAGE_PROVIDER=
REELFORGE_SMOKE_IMAGE_MODEL=
REELFORGE_SMOKE_VOICE_PROVIDER=
REELFORGE_SMOKE_VOICE_MODEL=
